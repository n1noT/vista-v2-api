meta {
  name: Get league detail
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/predictions/leagues/1
  body: none
  auth: inherit
}

docs {
  Requires the access_token cookie. Returns the team list (+ seasonId) for the given league's current season — 404 "Championnat introuvable." if the league doesn't exist or has no TeamLeagueSeason rows for its current season.
}
