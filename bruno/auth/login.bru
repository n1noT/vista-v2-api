meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "testuser@example.com",
    "password": "password123"
  }
}

docs {
  Sets the access_token session cookie on success. 401 on wrong credentials, 403 if the account is banned.
}
