meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "pseudo": "testuser",
    "email": "testuser@example.com",
    "password": "password123"
  }
}

docs {
  Creates an account and sets the access_token session cookie (auto-login). Re-run with a different email/pseudo once the first one is taken (409).
}
