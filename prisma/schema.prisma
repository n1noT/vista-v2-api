// schema.prisma

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

enum PredictionState {
  DRAFT
  SUBMITTED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  pseudo       String       @unique
  passwordHash String
  avatarUrl    String?
  role         Role         @default(PLAYER)
  bannedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  
  predictions  Prediction[]
}

model Team {
  id               Int                @id @default(autoincrement())
  externalId       Int                @unique
  name             String
  logoUrl          String?

  participations            TeamLeagueSeason[]
  predictionItems  PredictionItem[]
}

model League {
  id          Int                @id @default(autoincrement())
  externalId  Int                @unique
  name        String
  logoUrl     String?

  seasons     Season[]
  predictions Prediction[]
}

model Season {
  id              Int                @id @default(autoincrement())
  externalId      Int                @unique
  leagueId        Int
  startDate       DateTime
  endDate         DateTime
  currentMatchday Int
  isCurrent       Boolean

  league          League             @relation(fields: [leagueId], references: [id])
  participations           TeamLeagueSeason[]
  predictions     Prediction[]
}

model TeamLeagueSeason {
  id               Int    @id @default(autoincrement())
  teamId           Int
  seasonId         Int
  position         Int
  playedGames      Int
  // Bookmaker-expected position ("F" in Calcul_Cotes.md), admin-edited only. Float because
  // tied bookmaker odds resolve to an averaged position (e.g. 3.5 for two teams tied for 3rd).
  expectedPosition Float?

  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([teamId, seasonId])
}

model Prediction {
  id                Int               @id @default(autoincrement())
  userId            String
  leagueId          Int
  seasonId          Int
  status            PredictionState   @default(DRAFT)
  submittedAt       DateTime?
  points            Int?
  pointsCalculatedAt DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  league      League            @relation(fields: [leagueId], references: [id])
  season      Season            @relation(fields: [seasonId], references: [id])

  items       PredictionItem[]
}

model PredictionItem {
  id           Int        @id @default(autoincrement())
  predictionId Int
  teamId       Int
  position     Int
  points       Int?

  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id])
}